@startuml
hide circle

entity издательство {
  * название
  --
  адрес
}

entity книга {
  * ISBN
  --
  название
  автор
  год издания
  количество страниц
}

entity категория {
  * название
}

entity экземпляр <<weak>> {
  * номер копии
  --
  место на полке
}

entity читатель {
  * ID
  --
  имя
  фамилия
  адрес
  дата рождения
}

entity выдача <<weak>> {
  * дата выдачи
  --
  планируемая дата возврата
  фактическая дата возврата (может отсутствовать)
}

note right of экземпляр : ключ: ISBN книги + номер копии
note right of выдача : ключ: экземпляр + дата выдачи,\nповторные выдачи — разные записи

издательство ||..o{ книга : выпускает
книга }o..|{ категория : относится к
категория |o..o{ категория : подкатегория
книга ||--o{ экземпляр : имеет
экземпляр ||--o{ выдача : выдаётся
читатель ||..o{ выдача : берёт
@enduml
